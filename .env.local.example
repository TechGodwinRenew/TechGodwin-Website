# Database (Supabase PostgreSQL)
# Get your connection string from Supabase Dashboard > Settings > Database
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?schema=public"

# Supabase API (Optional - for future Supabase client SDK usage)
# Find these in Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Payment - Stripe (Optional, activate for payments)
# Sign up at stripe.com for API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# Payment - PayPal (Optional, activate for payments)
# Sign up at developer.paypal.com for credentials
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."

# Email Service (Optional - for sending notifications)
# Configure your SMTP provider (SendGrid, Mailgun, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@techgodwin.com"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TechGodwin"

# Analytics (Optional)
NEXT_PUBLIC_GA_ID="G_..."
